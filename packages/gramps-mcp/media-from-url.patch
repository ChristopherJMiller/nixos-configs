diff --git a/src/gramps_mcp/url_fetch.py b/src/gramps_mcp/url_fetch.py
new file mode 100644
index 0000000..af1a7a3
--- /dev/null
+++ b/src/gramps_mcp/url_fetch.py
@@ -0,0 +1,138 @@
+"""
+Fetch a document from a public URL so create_media can store it.
+
+MCP has no way to move a file: a client can only send tool arguments. A URL
+lets the server fetch the bytes itself, which covers the common case of a
+record image found online. The server runs inside the cluster, though, so an
+unguarded fetch would let any caller have it read internal addresses and file
+the response into the tree, where it could be read back. So:
+
+  * https only, with a size cap and a timeout;
+  * every address the host resolves to must be public, checked before the
+    request, and the address actually connected to is checked again before
+    the body is read, which defeats DNS rebinding between the two;
+  * redirects are followed by hand, so each hop gets the same checks;
+  * only PDFs and images are accepted, identified from the bytes rather than
+    the Content-Type, since error pages served as application/pdf and PDFs
+    served as application/octet-stream are both common.
+"""
+
+import asyncio
+import ipaddress
+import socket
+from typing import Optional, Tuple
+from urllib.parse import urljoin, urlsplit
+
+import httpx
+
+MAX_BYTES = 25 * 1024 * 1024
+MAX_REDIRECTS = 5
+TIMEOUT = httpx.Timeout(60.0, connect=15.0)
+USER_AGENT = "gramps-mcp (genealogy research; fetches one document per request)"
+
+_SIGNATURES = (
+    (b"%PDF-", "application/pdf"),
+    (b"\x89PNG\r\n\x1a\n", "image/png"),
+    (b"\xff\xd8\xff", "image/jpeg"),
+    (b"GIF87a", "image/gif"),
+    (b"GIF89a", "image/gif"),
+    (b"II*\x00", "image/tiff"),
+    (b"MM\x00*", "image/tiff"),
+)
+
+
+class FetchRefused(Exception):
+    """The URL was refused or could not be fetched as a document."""
+
+
+def _sniff(head: bytes) -> Optional[str]:
+    """Return the MIME type the leading bytes identify, or None."""
+    for signature, mime in _SIGNATURES:
+        if head.startswith(signature):
+            return mime
+    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
+        return "image/webp"
+    return None
+
+
+def _require_public(address: str, host: str) -> None:
+    ip = ipaddress.ip_address(address)
+    if not ip.is_global:
+        raise FetchRefused(f"{host} is at non-public address {ip}; refusing")
+
+
+async def _check_host(host: str, port: int) -> None:
+    """Refuse a host unless every address it resolves to is public."""
+    try:
+        infos = await asyncio.get_running_loop().getaddrinfo(
+            host, port, type=socket.SOCK_STREAM
+        )
+    except socket.gaierror as e:
+        raise FetchRefused(f"cannot resolve {host}: {e}") from e
+    for info in infos:
+        _require_public(info[4][0], host)
+
+
+async def fetch_document(url: str) -> Tuple[bytes, str, str]:
+    """
+    Fetch a PDF or image from a public https URL.
+
+    Returns:
+        (content, mime type, final URL after redirects)
+
+    Raises:
+        FetchRefused: for a refused address, scheme, size or file type, or a
+            failed request
+    """
+    async with httpx.AsyncClient(
+        timeout=TIMEOUT, follow_redirects=False, trust_env=False
+    ) as client:
+        for _ in range(MAX_REDIRECTS + 1):
+            parts = urlsplit(url)
+            if parts.scheme != "https":
+                raise FetchRefused(f"only https URLs are fetched, not {url}")
+            if not parts.hostname:
+                raise FetchRefused(f"no host in {url}")
+            await _check_host(parts.hostname, parts.port or 443)
+
+            try:
+                async with client.stream(
+                    "GET", url, headers={"User-Agent": USER_AGENT}
+                ) as response:
+                    stream = response.extensions.get("network_stream")
+                    peer = stream.get_extra_info("server_addr") if stream else None
+                    if not peer:
+                        raise FetchRefused(f"could not confirm the address of {url}")
+                    _require_public(peer[0], parts.hostname)
+
+                    if response.is_redirect:
+                        location = response.headers.get("location")
+                        if not location:
+                            raise FetchRefused(f"redirect without a location from {url}")
+                        url = urljoin(url, location)
+                        continue
+                    if response.status_code != 200:
+                        raise FetchRefused(f"{url} returned HTTP {response.status_code}")
+
+                    declared = response.headers.get("content-length")
+                    if declared and declared.isdigit() and int(declared) > MAX_BYTES:
+                        raise FetchRefused(f"{url} is larger than {MAX_BYTES} bytes")
+                    chunks, total = [], 0
+                    async for chunk in response.aiter_bytes():
+                        total += len(chunk)
+                        if total > MAX_BYTES:
+                            raise FetchRefused(f"{url} is larger than {MAX_BYTES} bytes")
+                        chunks.append(chunk)
+            except httpx.HTTPError as e:
+                raise FetchRefused(f"fetching {url} failed: {e}") from e
+
+            content = b"".join(chunks)
+            mime = _sniff(content[:16])
+            if mime is None:
+                served = response.headers.get("content-type", "no content type")
+                raise FetchRefused(
+                    f"{url} is not a PDF or image (served as {served})"
+                )
+            return content, mime, url
+
+        raise FetchRefused(f"more than {MAX_REDIRECTS} redirects")
