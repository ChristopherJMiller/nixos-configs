+async def get_note_tool(arguments: Dict) -> List[TextContent]:
+    """
+    Read a note's text, a range of characters at a time.
+
+    Every other read path cuts a note short - to 500 characters in the note
+    formatter, 50 in the person and family views - so a long note could be
+    neither read in full nor safely rewritten, since create_note replaces the
+    whole text. This returns the exact text between start and start + length,
+    with the total length, where to continue, and what the note is attached to.
+    """
+    try:
+        params = NoteReadParams(**arguments)
+        tree_id = get_settings().gramps_tree_id
+
+        client = GrampsWebAPIClient()
+        try:
+            handle = params.handle
+            if not handle:
+                try:
+                    found = await client.make_api_call(
+                        ApiCalls.GET_NOTES,
+                        params={"gramps_id": params.gramps_id},
+                        tree_id=tree_id,
+                    )
+                except GrampsAPIError:
+                    found = None
+                if not found:
+                    raise GrampsAPIError(f"No note with gramps_id {params.gramps_id}")
+                handle = found[0]["handle"]
+
+            note = await client.make_api_call(
+                ApiCalls.GET_NOTE,
+                params={"backlinks": True},
+                tree_id=tree_id,
+                handle=handle,
+            )
+            attached = []
+            for kind, refs in (note.get("backlinks") or {}).items():
+                labels = [await _label(client, tree_id, kind.lower(), ref) for ref in refs]
+                ids = [label.split(" ", 1)[1] for label in labels]
+                attached.append(f"{kind.lower()} {', '.join(ids)}")
+        finally:
+            await client.close()
+
+        text = note_plain_text(note)
+        total = len(text)
+        start = min(params.start, total)
+        end = min(start + params.length, total)
+        position = f"Characters {start}-{end} of {total}; " + (
+            f"continue with start={end}" if end < total else "end of note"
+        )
+        header = "\n".join(
+            [
+                f"{note.get('type')} - {note.get('gramps_id')} - [{handle}]",
+                position,
+                f"Attached to: {'; '.join(attached) if attached else 'nothing'}",
+            ]
+        )
+        return [TextContent(type="text", text=f"{header}\n\n{text[start:end]}")]
+
+    except Exception as e:
+        return _format_error_response(e, "note read")
