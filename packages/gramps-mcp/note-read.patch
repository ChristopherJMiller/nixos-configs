+class NoteReadParams(BaseModel):
+    """Parameters for reading a note's text a range of characters at a time."""
+
+    gramps_id: Optional[str] = Field(None, description="Note ID, e.g. N0011")
+    handle: Optional[str] = Field(None, description="Note handle")
+    start: int = Field(
+        0, ge=0, description="Offset of the first character to return (0-based)"
+    )
+    length: int = Field(
+        10000, ge=1, le=50000, description="Maximum number of characters to return"
+    )
+
+    @model_validator(mode="after")
+    def _require_note(self) -> "NoteReadParams":
+        if not (self.gramps_id or self.handle):
+            raise ValueError("Give the note's gramps_id or handle")
+        return self
