diff --git a/src/gramps_mcp/client.py b/src/gramps_mcp/client.py
index 8df8f39..806167f 100644
--- a/src/gramps_mcp/client.py
+++ b/src/gramps_mcp/client.py
@@ -43,8 +43,21 @@ class GrampsWebAPIClient:
         self.base_url = base_url
 
     async def close(self):
-        """Close the HTTP client and auth manager."""
-        await self.auth_manager.close()
+        """Release this client.
+
+        Deliberately does not close the AuthManager's HTTP client. AuthManager
+        is a process wide singleton holding one shared httpx.AsyncClient, while
+        every tool builds a GrampsWebAPIClient and closes it in a finally
+        block. Because the MCP server handles tool calls concurrently, the
+        first call to finish was tearing the shared client out from under any
+        call still in flight, which surfaced as a bare "Unexpected error:" with
+        no message, since anyio.ClosedResourceError stringifies to "".
+
+        The singleton's client property already recreates the client when the
+        event loop changes, so leaving it open between calls is both correct
+        and cheaper. Call AuthManager.close() directly for a real shutdown.
+        """
+        return None
 
     async def _get_headers(self) -> Dict[str, str]:
         """Get authentication headers for API requests."""
