     async def get_token(self) -> str:
         """
         Get a valid access token, authenticating if needed.
 
+        The MCP server handles tool calls concurrently and they share this
+        singleton. Without a lock every call in a batch saw an empty cache and
+        authenticated at once, and Gramps Web rate limits /api/token/, so all
+        but the first came back "Authentication failed: HTTP 429". Serialise
+        acquisition so one call fetches the token and the rest reuse it.
+
         Returns:
             Valid access token
         """
-        # Check if we need to authenticate
