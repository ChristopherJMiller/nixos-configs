diff --git a/src/gramps_mcp/utils.py b/src/gramps_mcp/utils.py
index 7e419c1..f2f7c95 100644
--- a/src/gramps_mcp/utils.py
+++ b/src/gramps_mcp/utils.py
@@ -139,3 +139,22 @@ def note_plain_text(note_data: Dict[str, Any]) -> str:
     if isinstance(text, dict):
         text = text.get("string", "")
     return text if isinstance(text, str) else ""
+
+
+def gender_letter(gender: Any) -> str:
+    """
+    Render a Gramps gender code as a single letter.
+
+    Gramps defines Person.FEMALE 0, MALE 1, UNKNOWN 2 and OTHER 3. Four
+    separate copies of this mapping stopped at 2 and fell back to "U", so a
+    person recorded as Other displayed identically to one whose gender was
+    never recorded. Those mean different things, and collapsing them
+    misrepresents the record.
+
+    Args:
+        gender: Gramps gender code
+
+    Returns:
+        "F", "M", "O", or "U" when the code is Unknown or unrecognised
+    """
+    return {0: "F", 1: "M", 2: "U", 3: "O"}.get(gender, "U")
