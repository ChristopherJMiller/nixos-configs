+def _format_name(name_obj: dict) -> str:
+    """Format one Gramps Name object as "Given Surname"."""
+    if not name_obj:
+        return ""
+    given_name = name_obj.get("first_name", "")
+    surname_list = name_obj.get("surname_list", []) or []
+    surname = surname_list[0].get("surname", "") if surname_list else ""
+    return f"{given_name} {surname}".strip()
