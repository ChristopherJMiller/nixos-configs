@@ -6,9 +6,53 @@ Provides clean, consistent date formatting from Gramps date objects.
 
 import logging
 from datetime import datetime
+from typing import Optional
 
 logger = logging.getLogger(__name__)
 
+# Gramps date modifiers
+MOD_REGULAR = 0
+MOD_BEFORE = 1
+MOD_AFTER = 2
+MOD_ABOUT = 3
+MOD_RANGE = 4
+MOD_SPAN = 5
+MOD_TEXTONLY = 6
+MOD_FROM = 7
+MOD_TO = 8
+
+MODIFIER_PREFIXES = {
+    MOD_REGULAR: "",
+    MOD_BEFORE: "before ",
+    MOD_AFTER: "after ",
+    MOD_ABOUT: "about ",
+    MOD_RANGE: "between ",
+    MOD_SPAN: "from ",
+    MOD_TEXTONLY: "",
+    MOD_FROM: "from ",
+    MOD_TO: "to ",
+}
+
+QUALITY_SUFFIXES = {
+    0: "",  # regular
+    1: " (estimated)",
+    2: " (calculated)",
+}
+
+
+def _format_parts(day: int, month: int, year: int) -> Optional[str]:
+    """Format one day/month/year triple, or None when there is no usable year."""
+    try:
+        if year is None or year <= 0:
+            return None
+        if day > 0 and month > 0:
+            return datetime(year, month, day).strftime("%d %B %Y")
+        if month > 0:
+            return datetime(year, month, 1).strftime("%B %Y")
+        return str(year)
+    except (ValueError, TypeError):
+        return str(year) if isinstance(year, int) and year > 0 else None
+
 
 def format_date(date_obj: dict) -> str:
     """
@@ -28,54 +72,33 @@ def format_date(date_obj: dict) -> str:
     if formatted_date:
         return formatted_date
 
-    # Try to extract from dateval
