+    "family": ApiCalls.PUT_FAMILY,
+    "event": ApiCalls.PUT_EVENT,
+    "place": ApiCalls.PUT_PLACE,
+    "source": ApiCalls.PUT_SOURCE,
+    "citation": ApiCalls.PUT_CITATION,
+    "media": ApiCalls.PUT_MEDIA_ITEM,
+    "repository": ApiCalls.PUT_REPOSITORY,
+    "note": ApiCalls.PUT_NOTE,
+}
+_DELETE_CALLS = {
+    "person": ApiCalls.DELETE_PERSON,
+    "family": ApiCalls.DELETE_FAMILY,
+    "event": ApiCalls.DELETE_EVENT,
+    "place": ApiCalls.DELETE_PLACE,
+    "source": ApiCalls.DELETE_SOURCE,
+    "citation": ApiCalls.DELETE_CITATION,
+    "media": ApiCalls.DELETE_MEDIA_ITEM,
+    "repository": ApiCalls.DELETE_REPOSITORY,
+    "note": ApiCalls.DELETE_NOTE,
+}
+# What kind of object each list field points at, for naming the removed entry.
+_FIELD_TARGET = {
+    "citation_list": "citation",
+    "note_list": "note",
+    "media_list": "media",
+    "event_ref_list": "event",
+    "child_ref_list": "person",
