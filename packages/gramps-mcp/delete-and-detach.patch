+"""Pydantic models for deleting objects and detaching references."""
+
+from pydantic import BaseModel, Field
+
+from .simple_params import EntityType
+
+
+class DeleteParams(BaseModel):
+    """Parameters for deleting one object."""
+
+    type: EntityType = Field(..., description="Type of the object to delete")
+    handle: str = Field(..., min_length=8, description="Handle of the object")
+    force: bool = Field(
+        False,
+        description=(
+            "Delete even though other objects still refer to it. Gramps then "
+            "strips those references, and deleting a SOURCE also deletes every "
+            "citation of it. Without force the call refuses and lists the "
+            "referring objects."
+        ),
+    )
+
+
+class RemoveReferenceParams(BaseModel):
+    """Parameters for detaching one entry from a list field of an object."""
+
+    type: EntityType = Field(..., description="Type of the object to edit")
+    handle: str = Field(..., min_length=8, description="Handle of the object")
+    field: str = Field(
+        ...,
+        description=(
+            "List field to remove the entry from, e.g. citation_list, "
+            "note_list, media_list, tag_list, event_ref_list, child_ref_list, "
+            "reporef_list, parent_family_list, family_list, placeref_list"
+        ),
+    )
+    ref: str = Field(
+        ...,
+        min_length=8,
+        description=(
+            "Handle to remove: the list entry itself for plain handle lists, "
+            "or the entry whose 'ref' equals it for reference lists"
+        ),
+    )
