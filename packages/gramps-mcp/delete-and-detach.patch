+    "placeref_list": "place",
+}
+
+
+async def _label(client: GrampsWebAPIClient, tree_id: str, kind: str, handle: str) -> str:
+    """Name an object as "<kind> <gramps_id>", falling back to its handle."""
+    call = _GET_CALLS.get(kind)
+    if call is not None:
+        try:
+            obj = await client.make_api_call(call, tree_id=tree_id, handle=handle)
+            if obj and obj.get("gramps_id"):
+                return f"{kind} {obj['gramps_id']}"
+        except Exception:
+            pass
+    return f"{kind} {handle}"
+
+
+async def delete_object_tool(arguments: Dict) -> List[TextContent]:
+    """
+    Delete one object.
+
+    Upstream defined a DELETE call for every object type but registered no
+    tool, so cleanup could only happen in the web UI. Gramps Web deletes an
+    object together with every reference to it, and a source together with
+    all of its citations, so without force this refuses while anything still
+    refers to the object and names what does.
+    """
+    try:
+        params = DeleteParams(**arguments)
+        kind = params.type.value
+        tree_id = get_settings().gramps_tree_id
+
+        client = GrampsWebAPIClient()
+        try:
+            obj = await client.make_api_call(
+                _GET_CALLS[kind],
+                params={"backlinks": True},
+                tree_id=tree_id,
+                handle=params.handle,
+            )
+            label = f"{kind} {obj.get('gramps_id') or params.handle}"
+
+            referrers = []
+            for ref_kind, handles in (obj.get("backlinks") or {}).items():
+                for handle in handles:
+                    referrers.append(await _label(client, tree_id, ref_kind.lower(), handle))
+            if referrers and not params.force:
+                cascade = (
+                    " Deleting a source also deletes every citation of it."
+                    if kind == "source"
+                    else ""
+                )
+                return [
+                    TextContent(
+                        type="text",
+                        text=(
+                            f"Not deleted: {label} is still referred to by "
+                            f"{', '.join(referrers)}. Detach those with "
+                            "remove_reference, or pass force=true to delete it "
+                            f"and have Gramps strip the references.{cascade}"
+                        ),
+                    )
+                ]
+
+            result = await client.make_api_call(
+                _DELETE_CALLS[kind], tree_id=tree_id, handle=params.handle
+            )
+        finally:
+            await client.close()
+
+        deleted, updated = [], []
+        for item in result if isinstance(result, list) else []:
+            data = item.get("old") or item.get("new") or {}
+            name = f"{item.get('_class', '?').lower()} {data.get('gramps_id') or item.get('handle')}"
+            (deleted if item.get("type") == "delete" else updated).append(name)
+        text = f"Deleted {label}."
+        if len(deleted) > 1:
+            text += f"\nDeleted with it: {', '.join(d for d in deleted if d != label)}."
+        if updated:
+            text += f"\nReferences removed from: {', '.join(updated)}."
+        return [TextContent(type="text", text=text)]
+
+    except Exception as e:
+        return _format_error_response(e, "delete")
+
+
+async def remove_reference_tool(arguments: Dict) -> List[TextContent]:
+    """
+    Detach one entry from a list field of an object.
+
+    Every update goes through make_api_call's merge, which only ever adds to
+    *_list fields, so nothing could be taken off an object - a wrong citation
+    on an event, a note on the wrong person. This reads the object, drops the
+    entry and writes the object back whole, bypassing the merge, which would
+    otherwise put the entry straight back.
+    """
+    try:
+        params = RemoveReferenceParams(**arguments)
+        kind = params.type.value
+        tree_id = get_settings().gramps_tree_id
+
+        client = GrampsWebAPIClient()
+        try:
+            obj = await client.make_api_call(
+                _GET_CALLS[kind], tree_id=tree_id, handle=params.handle
+            )
+            label = f"{kind} {obj.get('gramps_id') or params.handle}"
+            items = obj.get(params.field)
+            if not isinstance(items, list):
+                raise GrampsAPIError(f"{label} has no list field '{params.field}'")
+
+            kept = [
+                item
+                for item in items
+                if item != params.ref
+                and not (isinstance(item, dict) and item.get("ref") == params.ref)
+            ]
+            if len(kept) == len(items):
+                raise GrampsAPIError(f"{params.ref} is not in {params.field} of {label}")
+
+            obj[params.field] = kept
+            url = client._build_url_with_substitution(
+                tree_id, _PUT_CALLS[kind].endpoint, {"handle": params.handle}
+            )
+            await client._make_request(method="PUT", url=url, json_data=obj)
+
+            target = _FIELD_TARGET.get(params.field)
+            removed = (
+                await _label(client, tree_id, target, params.ref)
+                if target
+                else params.ref
+            )
+            formatted = await _format_save_response(
+                client, obj, kind, "updated", tree_id
+            )
+        finally:
+            await client.close()
+
+        return [
+            TextContent(
+                type="text",
+                text=f"Removed {removed} from {params.field} of {label}.\n\n{formatted}",
+            )
+        ]
+
+    except Exception as e:
+        return _format_error_response(e, "remove reference")
