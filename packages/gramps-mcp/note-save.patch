+from pydantic import BaseModel, Field, field_validator
 
 from .base_params import BaseGetMultipleParams, BaseGetSingleParams
 
@@ -51,6 +51,20 @@ class NoteSaveParams(BaseModel):
     text: str = Field(..., description="Note text content")
     type: str = Field(..., description="The type of note")
 
+    @field_validator("text", mode="before")
+    @classmethod
+    def _unwrap_styled_text(cls, value: Any) -> Any:
+        """Accept the StyledText dict that model_dump below produces.
+
+        The server builds this model from the tool arguments, then hands the
+        tool arguments.model_dump(), which wraps text as StyledText, and the
+        tool validates that dict against this same model. Without unwrapping,
+        text arrives as a dict and every create_note call fails validation.
+        """
+        if isinstance(value, dict) and isinstance(value.get("string"), str):
+            return value["string"]
+        return value
+
     def model_dump(self, **kwargs: Any) -> dict[str, Any]:
         """Convert to API format with StyledText structure."""
         data = super().model_dump(**kwargs)
