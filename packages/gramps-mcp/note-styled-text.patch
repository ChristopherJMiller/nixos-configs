+def note_plain_text(note_data: Dict[str, Any]) -> str:
+    """
+    Return a note's body as plain text.
+
+    Gramps models a note body as StyledText, which the Web API serialises as
+    {"string": ..., "tags": [...]} rather than as a bare string. Code that
+    treated it as a string raised TypeError as soon as it sliced or measured
+    it, which took down any caller formatting a person who had notes. Accept
+    either shape so older and newer payloads both work.
+
+    Args:
+        note_data: A note object as returned by the Gramps Web API
+
+    Returns:
+        The note text, or "" when there is none
+    """
+    text = (note_data or {}).get("text", "")
+    if isinstance(text, dict):
+        text = text.get("string", "")
+    return text if isinstance(text, str) else ""
