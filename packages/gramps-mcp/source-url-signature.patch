+# Query parameters that mark a pre-signed, expiring URL (Azure SAS, AWS and
+# Google Cloud signed URLs, CloudFront). The rest of such a query is useless
+# once the signature expires, so the whole query is dropped.
+_SIGNING_PARAMS = frozenset(
+    {
+        "sig",
+        "signature",
+        "x-amz-signature",
+        "x-amz-credential",
+        "x-goog-signature",
+        "x-goog-credential",
+        "key-pair-id",
+        "policy",
+    }
+)
+
+
+def citable_url(url: str) -> str:
+    """
+    Return the URL worth recording as a document's source.
+
+    A pre-signed link stops working within minutes or hours, and its
+    signature is a credential while it lasts, so the query of any URL that
+    carries one is dropped; the path still names the document. Other queries
+    are kept, since some sites identify a record only by its query. The
+    fragment never matters for a fetch and is always dropped.
+    """
+    parts = urlsplit(url)
+    names = {name.lower() for name, _ in parse_qsl(parts.query, keep_blank_values=True)}
+    query = "" if names & _SIGNING_PARAMS else parts.query
+    return urlunsplit((parts.scheme, parts.netloc, parts.path, query, ""))
+
+
 class FetchRefused(Exception):
     """The URL was refused or could not be fetched as a document."""
 
