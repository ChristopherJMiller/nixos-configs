diff --git a/src/gramps_mcp/client.py b/src/gramps_mcp/client.py
index 806167f..18d573c 100644
--- a/src/gramps_mcp/client.py
+++ b/src/gramps_mcp/client.py
@@ -268,10 +268,27 @@ class GrampsWebAPIClient:
                                 
                                 if (isinstance(sample_existing, dict) and 'ref' in sample_existing and
                                     isinstance(sample_new, dict) and 'ref' in sample_new):
-                                    # Deduplicate reference objects based on 'ref' field
-                                    existing_refs = {item.get('ref') for item in existing_items if isinstance(item, dict)}
-                                    new_items = [item for item in value if isinstance(item, dict) and item.get('ref') not in existing_refs]
-                                    merged_data[key] = existing_items + new_items
+                                    # A reference whose 'ref' is already present updates
+                                    # that entry in place - only the keys sent change - so
+                                    # a role, frel/mrel, medium or call number can be
+                                    # corrected. Dropping it instead made every existing
+                                    # reference read-only. New refs are appended.
+                                    merged_items = list(existing_items)
+                                    position = {
+                                        item.get('ref'): i
+                                        for i, item in enumerate(merged_items)
+                                        if isinstance(item, dict)
+                                    }
+                                    for item in value:
+                                        if not isinstance(item, dict):
+                                            continue
+                                        i = position.get(item.get('ref'))
+                                        if i is None:
+                                            position[item.get('ref')] = len(merged_items)
+                                            merged_items.append(item)
+                                        else:
+                                            merged_items[i] = {**merged_items[i], **item}
+                                    merged_data[key] = merged_items
                                 elif isinstance(sample_existing, str) and isinstance(sample_new, str):
                                     # Deduplicate simple string handles
                                     existing_set = set(existing_items)
