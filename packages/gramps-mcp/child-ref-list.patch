+    @model_validator(mode="after")
+    def _child_handles_to_child_refs(self) -> "FamilySaveParams":
+        """Map child_handles onto the child_ref_list the Gramps API expects.
+
+        The request body is a plain model_dump of this model, so any field whose
+        name is not a Gramps object attribute is ignored by the API. Gramps
+        stores children on the family as child_ref_list entries of the form
+        {"ref": handle}; child_handles is only the friendly spelling exposed to
+        callers. Without this mapping the family half of the parent/child link
+        is never written. The call still reports success, but the family has no
+        children, so family views show none and ancestor/descendant traversal
+        stops at that family.
+        """
+        if not self.child_handles:
+            return self
+        refs = list(self.child_ref_list or [])
+        seen = {ref.get("ref") for ref in refs if isinstance(ref, dict)}
+        for handle in self.child_handles:
+            if handle and handle not in seen:
+                refs.append({"ref": handle})
+                seen.add(handle)
+        self.child_ref_list = refs
+        return self
+
 
